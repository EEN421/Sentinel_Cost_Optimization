source
| where DeviceVendor == "Fortinet" or DeviceProduct startswith "Fortigate"
| extend _msg_msg = tostring(columnifexists("Message",""))
| extend _msg_act = tostring(columnifexists("Activity",""))
| extend _msg = iff(isnotempty(_msg_msg), _msg_msg, _msg_act)
| where _msg !has "traffic:forward close"
| where _msg !has "traffic:forward client-rst"
| where _msg !has "traffic:forward server-rst"
| where _msg !has "traffic:forward timeout"
| where _msg !has "traffic:forward cancel"
| where _msg !has "traffic:forward client-fin"
| where _msg !has "traffic:forward server-fin"
| where _msg !has "traffic:local close"
| where _msg !has "traffic:local client-rst"
| where _msg !has "traffic:local timeout"
| where _msg !has "traffic:local server-rst"
| project-away _msg_msg, _msg_act
